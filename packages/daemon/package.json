{
  "name": "@brsorganizer/daemon",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "brsorganizer-daemon": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
